#!/usr/bin/env python3
"""
generate_solution_skeletons.py

Convert worked solutions into "operatorized" solution skeletons.

Input:
  - JSONL: one object per line
  - JSON: a list[object]

Each object should contain at least:
  - id (optional but recommended)
  - question (string)
  - solution (string)  # worked solution / explanation / derivation

Output:
  - JSONL, one object per line, with:
      id, skeleton (structured), operators_used, meta

Usage:
  export OPENAI_API_KEY="..."
  python3 generate_solution_skeletons.py \
      --in solutions.jsonl \
      --out skeletons.jsonl \
      --model gpt-4.1-mini \
      --max-items 0 \
      --resume

Notes:
  - Uses OpenAI Responses API via the official python SDK.
  - If you don’t want to depend on OpenAI, you can replace call_llm() with your local model call.
"""

from __future__ import annotations

import argparse
import dataclasses
import hashlib
import json
import os
import sys
import time
from typing import Any, Dict, Iterable, List, Optional, Tuple, Union

# --- Optional OpenAI dependency ---
try:
    from openai import OpenAI
except Exception:
    OpenAI = None

from dotenv import load_dotenv
load_dotenv()


# ---------------------------
# Operator schema (editable)
# ---------------------------

OPERATOR_CATALOG = [
    # Generic / cross-domain operators
    "PARSE_GIVENS",          # extract givens/unknowns/targets
    "NORMALIZE_SYMBOLS",     # introduce consistent variable names
    "CHOOSE_FRAMEWORK",      # pick approach: Newton/Energy/Equilibrium/Kinematics/etc.
    "STATE_LAWS",            # state relevant laws/principles/equations
    "MODEL_ASSUMPTIONS",     # idealizations/constraints
    "SETUP_EQUATIONS",       # translate model to equations
    "SUBSTITUTE",            # plug in values/relations
    "SOLVE",                 # algebraic solve for target
    "CHECK_DIMENSIONS",      # units/dimension check
    "SANITY_CHECK",          # limiting cases, magnitude check
    "FINAL_ANSWER",          # present final result succinctly

    # Physics-leaning (you can prune/add)
    "DRAW_FBD",              # free-body diagram verbalization
    "APPLY_NEWTON_2",        # F=ma setup
    "APPLY_ENERGY",          # conservation of energy / work-energy
    "APPLY_MOMENTUM",        # impulse/momentum
    "APPLY_KINEMATICS",      # kinematics relations
    "APPLY_CIRCULAR",        # centripetal relations
    "APPLY_ELECTROSTATICS",  # Coulomb / field / potential
    "APPLY_CIRCUITS",        # KCL/KVL/equivalent resistance, etc.
    "APPLY_THERMODYNAMICS",  # 1st law / PV work, etc.
]

# Skeleton step JSON schema we instruct the model to output:
# {
#   "op": "<OPERATOR_NAME>",
#   "in": { ... },     # inputs / referenced variables
#   "out": { ... },    # outputs produced by this step
#   "note": "short human-readable note"
# }


# ---------------------------
# I/O helpers
# ---------------------------

def load_items(path: str) -> List[Dict[str, Any]]:
    with open(path, "r", encoding="utf-8") as f:
        text = f.read().strip()
    if not text:
        return []
    # Heuristic: JSONL if first non-ws line starts with "{"
    # but JSON list also starts with "[". We'll detect.
    if text[0] == "[":
        data = json.loads(text)
        if not isinstance(data, list):
            raise ValueError("JSON input must be a list of objects.")
        return data
    # JSONL
    items = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        items.append(json.loads(line))
    return items


def iter_jsonl(path: str) -> Iterable[Dict[str, Any]]:
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            yield json.loads(line)


def write_jsonl(path: str, rows: Iterable[Dict[str, Any]]) -> None:
    with open(path, "a", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")


def existing_ids_from_out(out_path: str) -> set:
    if not os.path.exists(out_path):
        return set()
    ids = set()
    try:
        for obj in iter_jsonl(out_path):
            if "id" in obj:
                ids.add(str(obj["id"]))
    except Exception:
        # If output is corrupted, don't silently skip; but keep safe.
        return ids
    return ids


def stable_id(item: Dict[str, Any], idx: int) -> str:
    """If no id provided, create a stable hash-based id from question+solution."""
    if "id" in item and item["id"] is not None:
        return str(item["id"])
    q = (item.get("question") or "").strip()
    s = (item.get("solution") or "").strip()
    h = hashlib.sha1((q + "\n---\n" + s).encode("utf-8")).hexdigest()[:12]
    return f"auto_{idx}_{h}"


# ---------------------------
# Prompting
# ---------------------------

def build_prompt(question: str, solution: str) -> str:
    ops = ", ".join(OPERATOR_CATALOG)
    return f"""You convert worked solutions into *operatorized solution skeletons*.

Rules:
- Output MUST be valid JSON (no markdown).
- Output MUST match the schema:
  {{
    "operators_used": ["OP1", "OP2", ...],
    "skeleton": [
      {{"op": "OP_NAME", "in": {{}}, "out": {{}}, "note": "..." }},
      ...
    ],
    "final": {{"target": "...", "value": "...", "units": "...", "expression": "..."}}
  }}

Operator constraints:
- Each skeleton step MUST use an operator from this allowed list:
  [{ops}]
- Use as FEW steps as possible while preserving the logical pathway.
- Prefer "SETUP_EQUATIONS" then "SOLVE" instead of many micro-steps.
- "in" and "out" should be small dictionaries with symbolic names (e.g., m, k, v0).
- "note" should be short (<= 20 words).
- Include CHECK_DIMENSIONS and SANITY_CHECK when appropriate (esp. physics).

Interpretation:
- The question provides the target.
- The worked solution provides the method; you must *abstract it* into operators.

QUESTION:
{question}

WORKED SOLUTION:
{solution}
"""


# ---------------------------
# LLM call
# ---------------------------

def call_llm(
    client: Any,
    model: str,
    prompt: str,
    seed: Optional[int] = None,
    max_output_tokens: int = 900,
) -> Dict[str, Any]:
    """
    Calls OpenAI Responses API and returns parsed JSON.

    If you use a different provider/local model, replace this function
    but keep the returned dict shape.
    """
    if client is None:
        raise RuntimeError(
            "OpenAI client not available. Install openai (`pip install openai`) "
            "and set OPENAI_API_KEY, or replace call_llm() with your local model call."
        )

    kwargs: Dict[str, Any] = {}
    # Some models accept seed; harmless to include only when provided.
    if seed is not None:
        kwargs["seed"] = seed

    resp = client.responses.create(
        model=model,
        input=prompt,
        max_output_tokens=max_output_tokens,
        **kwargs,
    )

    # The SDK returns output text in a structured way; we’ll extract concatenated text.
    # Compatible approach:
    text_parts: List[str] = []
    for out in resp.output:
        if out.type == "message":
            for c in out.content:
                if c.type == "output_text":
                    text_parts.append(c.text)
    raw = "".join(text_parts).strip()

    # Parse JSON strictly; if it fails, raise so caller can retry/fallback.
    return json.loads(raw)


# ---------------------------
# Validation + light repair
# ---------------------------

def validate_skeleton(obj: Dict[str, Any]) -> Tuple[bool, str]:
    if not isinstance(obj, dict):
        return False, "Top-level is not an object."
    if "skeleton" not in obj or not isinstance(obj["skeleton"], list):
        return False, "Missing or invalid 'skeleton' list."
    for i, step in enumerate(obj["skeleton"]):
        if not isinstance(step, dict):
            return False, f"Step {i} is not an object."
        op = step.get("op")
        if op not in OPERATOR_CATALOG:
            return False, f"Step {i} has invalid operator: {op}"
        if "in" not in step or "out" not in step:
            return False, f"Step {i} missing 'in' or 'out'."
    return True, "ok"


def force_repair_prompt(bad_json_text: str) -> str:
    ops = ", ".join(OPERATOR_CATALOG)
    return f"""Fix the following so it becomes VALID JSON matching the required schema.
No markdown. Output JSON only.
Operators allowed: [{ops}]

BROKEN:
{bad_json_text}
"""


# ---------------------------
# Main pipeline
# ---------------------------

def process_items(
    items: List[Dict[str, Any]],
    out_path: str,
    model: str,
    resume: bool,
    max_items: int,
    seed: Optional[int],
    sleep_s: float,
    retries: int,
) -> None:
    client = OpenAI() if OpenAI is not None else None

    done_ids = existing_ids_from_out(out_path) if resume else set()

    written = 0
    total = len(items)

    for idx, item in enumerate(items):
        if max_items and written >= max_items:
            break

        q = (item.get("question") or "").strip()
        s = (item.get("solution") or "").strip()
        if not q or not s:
            continue

        _id = stable_id(item, idx)
        if _id in done_ids:
            continue

        prompt = build_prompt(q, s)

        last_err = None
        for attempt in range(retries + 1):
            try:
                obj = call_llm(
                    client=client,
                    model=model,
                    prompt=prompt,
                    seed=seed,
                )
                ok, msg = validate_skeleton(obj)
                if not ok:
                    raise ValueError(f"Skeleton failed validation: {msg}")
                row = {
                    "id": _id,
                    "question": q,
                    "skeleton": obj.get("skeleton"),
                    "operators_used": obj.get("operators_used"),
                    "final": obj.get("final"),
                    "meta": {
                        "model": model,
                        "seed": seed,
                        "idx": idx,
                        "total": total,
                    },
                }
                write_jsonl(out_path, [row])
                written += 1
                done_ids.add(_id)
                break
            except Exception as e:
                last_err = e
                # One repair attempt: ask model to fix JSON/constraints
                if attempt == 0:
                    try:
                        # if call_llm failed due to JSON parse, we don't have the raw.
                        # so we do a generic retry; for more advanced repair, wrap call_llm to return raw too.
                        pass
                    except Exception:
                        pass
                if attempt < retries:
                    time.sleep(1.0 + attempt)
                continue

        if last_err is not None and _id not in done_ids:
            # Write a failure record so resume won’t loop forever unless you delete it.
            fail_row = {
                "id": _id,
                "question": q,
                "error": str(last_err),
                "meta": {"model": model, "seed": seed, "idx": idx, "total": total},
            }
            write_jsonl(out_path, [fail_row])
            written += 1
            done_ids.add(_id)

        if sleep_s > 0:
            time.sleep(sleep_s)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--in", dest="inp", required=True, help="Input solution packet (.json or .jsonl)")
    ap.add_argument("--out", dest="out", required=True, help="Output .jsonl file (appended)")
    ap.add_argument("--model", default="gpt-4.1-mini", help="Model name")
    ap.add_argument("--resume", action="store_true", help="Skip ids already in output")
    ap.add_argument("--max-items", type=int, default=0, help="0 = all, else limit count")
    ap.add_argument("--seed", type=int, default=None, help="Optional seed for repeatability")
    ap.add_argument("--sleep", type=float, default=0.0, help="Sleep seconds between calls")
    ap.add_argument("--retries", type=int, default=1, help="Retries per item")
    args = ap.parse_args()

    # Basic env check
    if OpenAI is None:
        print("WARNING: openai package not installed. Install with: pip install openai", file=sys.stderr)
    if not os.getenv("OPENAI_API_KEY"):
        print("WARNING: OPENAI_API_KEY not set. Calls will fail unless you use a different backend.", file=sys.stderr)

    items = load_items(args.inp)
    if not items:
        print("No items found in input.", file=sys.stderr)
        sys.exit(1)

    process_items(
        items=items,
        out_path=args.out,
        model=args.model,
        resume=args.resume,
        max_items=args.max_items,
        seed=args.seed,
        sleep_s=args.sleep,
        retries=args.retries,
    )


if __name__ == "__main__":
    main()
