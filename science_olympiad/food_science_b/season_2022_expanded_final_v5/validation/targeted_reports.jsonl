{"id": "food-science-b-curated-frq-003", "valid": true, "deterministic_errors": [], "judge": {"solvable": true, "independent_answer": "Only the sugars from the honey count as added sugars; the lactose naturally in the milk does not count as added sugar.", "science_correct": true, "division_b_appropriate": true, "food_science_relevant": true, "difficulty_match": true, "reasoning_depth_match": true, "source_level_calibrated": true, "source_scope_faithful": true, "single_unambiguous_answer": true, "competition_faithful": true, "style_faithful": true, "concise": true, "distractors_plausible": true, "safety_appropriate": true, "plan_faithful": true, "novel": true, "issues": [], "answer_agrees": true}}
{"id": "food-science-b-curated-frq-004", "valid": true, "deterministic_errors": [], "judge": {"solvable": true, "independent_answer": "They differ because water activity measures how much of the water is free and available for microbes, not just how much total water is present. In Food A (aw = 0.60), most water is bound (e.g., by solutes), so microbes cannot grow well, making it more shelf-stable. In Food B (aw = 0.90), more water is available for microbial use, so it supports growth. Water activity, not percent water, is the better predictor of microbial growth.", "science_correct": true, "division_b_appropriate": true, "food_science_relevant": true, "difficulty_match": true, "reasoning_depth_match": true, "source_level_calibrated": true, "source_scope_faithful": true, "single_unambiguous_answer": true, "competition_faithful": true, "style_faithful": true, "concise": true, "distractors_plausible": true, "safety_appropriate": true, "plan_faithful": true, "novel": true, "issues": [], "answer_agrees": true, "answer_equivalence": {"compatible": true, "issues": []}}}
